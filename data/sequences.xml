<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data noupdate="1">

        <record id="appointment_sequence" model="ir.sequence">
            <field name="name">Appointment Sequence</field>
            <field name="code">the.appointments.sequence</field>
            <field name="prefix">APP/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>

        <record id="prescription_sequence" model="ir.sequence">
            <field name="name">Prescription Sequence</field>
            <field name="code">the.prescription.sequence</field>
            <field name="prefix">PRE/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>

    </data>

</odoo>